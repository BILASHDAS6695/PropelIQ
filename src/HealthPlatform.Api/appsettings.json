{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=healthplatform;Username=postgres;Password=admin;Maximum Pool Size=100"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Ssl": false,
    "ConnectTimeout": 5000,
    "SyncTimeout": 1000,
    "AbortOnConnectFail": false
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithEnvironmentName", "WithThreadId"],
    "Properties": {
      "Application": "HealthPlatform.Api"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "JwtSettings": {
    "Issuer":    "HealthPlatformApi",
    "Audience":  "HealthPlatformClients",
    "SecretKey": "CHANGE-ME-USE-A-SECRET-MANAGER-IN-PRODUCTION"
  },
  "AccountSecurity": {
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "PasswordExpiryDays": 90,
    "PasswordHistorySize": 5
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 587,
    "UseSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@healthplatform.local",
    "FromName": "HealthPlatform"
  },
  "AllowedHosts": "*"
}
