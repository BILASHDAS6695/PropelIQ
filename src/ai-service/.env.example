# Internal API key — override in deployment secrets
INTERNAL_API_KEY=changeme
# Listening port
PORT=8000
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Ollama (local LLM — ADR-004)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Redis session store
REDIS_URL=redis://localhost:6379/0
